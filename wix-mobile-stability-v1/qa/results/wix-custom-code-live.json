 {
  "position": "head",
  "loadOnce": "false",
  "name": "Sayfa Yükleniyor Script",
  "html": "<style>\n  #knpGlobalLoader {\n    position: fixed;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    background: radial-gradient(circle at 50% 42%, #232327 0%, #17171a 55%, #0a0a0b 100%);\n    z-index: 2147483647;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 18px;\n    box-sizing: border-box;\n    padding: 0 28px;\n    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, Arial, sans-serif;\n    transition: opacity 0.5s ease;\n    animation: knpFadeIn 0.35s ease;\n    overflow: hidden;\n  }\n  @keyframes knpFadeIn {\n    from { opacity: 0; }\n    to { opacity: 1; }\n  }\n\n  /* KALDIRILDI (14 Eylül 2026 — kullanıcı kenar ışığı (Siri/Apple\n     Intelligence tarzı) fikrinden tamamen vazgeçti: \"Bundan vazgeçtim.\n     Ortadaki geri sayım daha farklı olabilir mi?\" Önceki üç iterasyonluk\n     kenar ışığı katmanları ve tam-siyah arka plan değişikliği tamamen\n     kaldırıldı; arka plan eski koyu gri radial-gradient haline döndürüldü. */\n\n  /* DEĞİŞTİRİLDİ (14 Eylül 2026 — \"Yüzde/skeleton tarzı\" seçildi): eski\n     dairesel ilerleme halkası + geri sayan rakam yerine, ince yatay bir\n     ilerleme çubuğu ve büyüyen bir yüzde sayacı kullanılıyor. Çubuğun\n     dolgusu üzerinde yumuşak bir \"shimmer\" (parlama) taraması akıyor --\n     klasik iskelet (skeleton) yükleme animasyonlarındaki gibi -- bu da\n     efekti daha minimal ve modern gösteriyor. */\n  #knpGlobalLoader .knp-progress-wrap {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 14px;\n    width: 220px;\n    max-width: 62vw;\n    flex-shrink: 0;\n  }\n  #knpGlobalLoader .knp-percent {\n    display: inline-block;\n    font-size: 21px;\n    font-weight: 700;\n    color: #f5f5f7;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: -0.3px;\n  }\n  #knpGlobalLoader .knp-percent.knp-pop {\n    animation: knpPop 0.45s cubic-bezier(.34,1.56,.64,1);\n  }\n  @keyframes knpPop {\n    0%   { transform: scale(0.85); opacity: 0.5; }\n    60%  { transform: scale(1.04); opacity: 1; }\n    100% { transform: scale(1); opacity: 1; }\n  }\n  #knpGlobalLoader .knp-bar-track {\n    position: relative;\n    width: 100%;\n    height: 6px;\n    border-radius: 999px;\n    background: rgba(255,255,255,0.09);\n    overflow: hidden;\n  }\n  #knpGlobalLoader .knp-bar-fill {\n    position: absolute;\n    inset: 0;\n    width: 0%;\n    border-radius: 999px;\n    /* DEĞİŞTİRİLDİ (14 Eylül 2026 — kurumsal renk isteği): eski mavi\n       (#0A84FF -> #64D2FF) yerine kurumsal yeşil #4CFC0F kullanılıyor.\n       Gradyanı tamamen düz tek renk yapmak yerine, hafif daha koyu bir\n       yeşil tondan (#3ACC0B) kurumsal yeşile (#4CFC0F) geçiş yapılıyor --\n       böylece çubuk düz bir blok gibi değil, hafif bir derinlik/parlaklık\n       hissiyle görünüyor, ama renk kimliği tamamen kurumsal yeşil. */\n    background: linear-gradient(90deg, #3ACC0B, #4CFC0F);\n    transition: width 1s linear;\n    overflow: hidden;\n  }\n  /* Dolgu üzerinde sürekli soldan sağa akan hafif bir parlama şeridi --\n     tamamlanma oranı sabit dursa bile çubuğun \"canlı/çalışıyor\" hissi\n     vermesi için (klasik skeleton-loading shimmer tekniği). */\n  #knpGlobalLoader .knp-bar-fill::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.5) 50%, transparent 100%);\n    transform: translateX(-100%);\n    animation: knpShimmer 1.6s ease-in-out infinite;\n  }\n  @keyframes knpShimmer {\n    to { transform: translateX(220%); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #knpGlobalLoader .knp-bar-fill::after {\n      animation: none;\n    }\n  }\n  #knpGlobalLoader .knp-text {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n    max-width: 280px;\n    text-align: center;\n  }\n  #knpGlobalLoader .knp-title {\n    font-size: 13px; font-weight: 600; color: #f5f5f7; letter-spacing: 0.2px;\n    line-height: 1.4;\n  }\n  #knpGlobalLoader .knp-sub {\n    position: relative;\n    width: 100%;\n    /* İki satıra kadar sabit yükseklik ayrılıyor -- metin uzunluğu değiştikçe\n       (ör. \"Verileriniz hazırlanıyor...\" -> \"Hazır!\") kutunun boyu ZIPLAMASIN\n       diye. Mobilde farklı uzunluktaki yazılar art arda değişirken önceki\n       halin üstüne binip \"birbirine karışması\" sorununun kaynağı buydu. */\n    min-height: 30px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  #knpGlobalLoader .knp-sub span {\n    display: block;\n    font-size: 11px;\n    line-height: 1.4;\n    color: #8e8e93;\n    word-break: keep-all;\n    overflow-wrap: break-word;\n  }\n\n  /* Küçük ekranlar (telefonlar) için biraz daha kompakt boyutlar. */\n  @media (max-width: 420px) {\n    #knpGlobalLoader { gap: 14px; padding: 0 22px; }\n    #knpGlobalLoader .knp-progress-wrap { width: 180px; max-width: 72vw; gap: 12px; }\n    #knpGlobalLoader .knp-percent { font-size: 18px; }\n    #knpGlobalLoader .knp-title { font-size: 12px; }\n    #knpGlobalLoader .knp-sub span { font-size: 10.5px; }\n    #knpGlobalLoader .knp-sub { min-height: 28px; }\n  }\n</style>\n<div id=\"knpGlobalLoader\">\n  <div class=\"knp-progress-wrap\">\n    <span class=\"knp-percent\" id=\"knpPercentNum\">0%</span>\n    <div class=\"knp-bar-track\">\n      <div class=\"knp-bar-fill\" id=\"knpBarFill\"></div>\n    </div>\n  </div>\n  <div class=\"knp-text\">\n    <div class=\"knp-title\">Verileriniz hazırlanıyor</div>\n    <div class=\"knp-sub\"><span id=\"knpSub\">Lütfen bekleyin...</span></div>\n  </div>\n</div>\n<script>\n(function () {\n  // EKLENDİ (1 Eylül 2026): Yükleniyor ekranı artık gerçek veri hazır olur\n  // olmaz (bazen 1 saniyede) hemen kapanmıyor -- şık, premium görünümlü sabit\n  // bir 10 saniyelik geri sayım gösteriyor ve bu sürenin TAMAMINI bekliyor.\n  //\n  // DÜZELTME (1 Eylül 2026 — mobilde alt yazının \"birbirine karışması\"):\n  // Önceki denemelerde alt yazı saniyeye göre değişiyordu (\"Verileriniz\n  // hazırlanıyor...\" -> \"Neredeyse hazır...\" -> \"Son saniyeler...\" ->\n  // \"Hazır!\") ve bu geçiş mobilde hala görsel olarak karışmaya neden oluyordu.\n  // Kullanıcı isteği üzerine bu değişken metin TAMAMEN KALDIRILDI -- alt yazı\n  // artık SABİT, hiç değişmiyor. Sadece yüzde sayacı ve ilerleme çubuğu\n  // değişiyor; metin hiç dokunulmadığı için karışma/örtüşme ihtimali de\n  // ortadan kalkıyor.\n  //\n  // DEĞİŞTİRİLDİ (14 Eylül 2026 — \"yüzde/skeleton tarzı\"na geçildi): dairesel\n  // ilerleme halkası + geri sayan rakam yerine artık yatay ince bir ilerleme\n  // çubuğu ve 0%'den 100%'e SAYAN bir yüzde göstergesi var. Countdown süresi\n  // (COUNTDOWN_FROM) mantığı aynı kaldı, sadece görsel gösterim değişti.\n  var COUNTDOWN_FROM = 10;\n\n  var el = document.getElementById('knpGlobalLoader');\n  var fillEl = document.getElementById('knpBarFill');\n  var percentEl = document.getElementById('knpPercentNum');\n\n  function render(sec) {\n    var percent = Math.round(((COUNTDOWN_FROM - sec) / COUNTDOWN_FROM) * 100);\n\n    percentEl.textContent = percent + '%';\n    // Pop animasyonunu her yüzde değişiminde yeniden tetikle.\n    percentEl.classList.remove('knp-pop');\n    void percentEl.offsetWidth; // reflow ile animasyonu resetle\n    percentEl.classList.add('knp-pop');\n\n    fillEl.style.width = percent + '%';\n  }\n\n  var remaining = COUNTDOWN_FROM;\n  render(remaining);\n\n  var timer = setInterval(function () {\n    remaining -= 1;\n\n    if (remaining <= 0) {\n      clearInterval(timer);\n      render(0);\n      setTimeout(function () {\n        if (el) {\n          el.style.opacity = '0';\n          setTimeout(function () {\n            if (el && el.parentNode) el.parentNode.removeChild(el);\n          }, 500);\n        }\n      }, 350);\n    } else {\n      render(remaining);\n    }\n  }, 1000);\n})();\n</script>"
 },
 {
  "position": "head",
  "loadOnce": "false",
  "name": "Özel Yükleniyor % Script",
  "html": "\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@900&display=swap');\n\n/* 1N DIGITAL MEDIA — GLOBAL LOADER V1 */\n\n#n1GlobalLoader {\n  position: fixed !important;\n  inset: 0 !important;\n  z-index: 2147483647 !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  overflow: hidden !important;\n  background: #080A09 !important;\n  opacity: 1;\n  pointer-events: all;\n  transition: opacity .5s ease;\n}\n\n#n1GlobalLoader,\n#n1GlobalLoader * {\n  box-sizing: border-box;\n}\n\n#n1GlobalLoader .n1-loader-counter {\n  display: flex !important;\n  align-items: baseline !important;\n  justify-content: center !important;\n  font-family: 'Montserrat', Arial, sans-serif !important;\n  font-size: 210px !important;\n  font-weight: 900 !important;\n  line-height: 1 !important;\n  letter-spacing: -.09em !important;\n  white-space: nowrap !important;\n  font-variant-numeric: tabular-nums !important;\n  font-feature-settings: \"tnum\" 1 !important;\n  font-synthesis: none !important;\n  transform: none !important;\n  transition: none !important;\n  animation: none !important;\n}\n\n#n1GlobalLoader .n1-loader-percent {\n  display: inline-block;\n  flex-shrink: 0;\n  margin-right: -.045em;\n  color: #A1FF00 !important;\n}\n\n#n1GlobalLoader .n1-loader-digits {\n  display: inline-block !important;\n  flex-shrink: 0 !important;\n  width: 2ch !important;\n  color: #EEEDE8 !important;\n  text-align: left !important;\n  font-family: inherit !important;\n  font-weight: 900 !important;\n  letter-spacing: -.12em !important;\n  font-variant-numeric: tabular-nums !important;\n  font-feature-settings: \"tnum\" 1 !important;\n  transform: none !important;\n  transition: none !important;\n  animation: none !important;\n}\n\n/* TABLET */\n@media (min-width: 768px) and (max-width: 1024px) {\n  #n1GlobalLoader .n1-loader-counter {\n    font-size: 145px !important;\n  }\n}\n\n/* MOBİL */\n@media (min-width: 361px) and (max-width: 767px) {\n  #n1GlobalLoader .n1-loader-counter {\n    font-size: 93px !important;\n  }\n}\n\n/* KÜÇÜK MOBİL */\n@media (max-width: 360px) {\n  #n1GlobalLoader .n1-loader-counter {\n    font-size: 82px !important;\n  }\n}\n\n/* KAPANIŞ */\n#n1GlobalLoader.n1-loader-close {\n  opacity: 0 !important;\n  pointer-events: none !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  #n1GlobalLoader {\n    transition: none !important;\n  }\n}\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  if (window.__n1GlobalLoaderInstalled) return;\n  window.__n1GlobalLoaderInstalled = true;\n\n  /* YÜKLEME EKRANI GÖSTERİLECEK SAYFALAR */\n  const ROUTES = new Set([\n    '/studyo-hikayesi',\n    '/yaratici-bakisimiz',\n    '/calisma-ritmimiz',\n\n    '/kreatif-studyo',\n    '/marka-deneyimi',\n    '/dijital-performans',\n    '/sosyal-medya-icerik',\n    '/web-e-ticaret',\n    '/yapay-zeka-inovasyon',\n\n    '/secili-isler',\n    '/marka-hikayeleri',\n    '/creative-showcase',\n\n    '/reklam-ajansi',\n    '/workshops',\n    '/icgoruler',\n\n    '/iletisim',\n    '/teklif-al',\n\n    '/ekibimize-katil',\n    '/acik-pozisyonlar',\n\n    '/kreatif-produksiyon',\n    '/e-ticaret-yonetimi',\n    '/sosyal-medya',\n    '/reklam-yonetimi',\n    '/ui-ux-tasarim',\n    '/yapay-zeka',\n    '/uygulama-gelistirme',\n\n    '/gizlilik-politikasi',\n    '/kvkk-aydinlatma-metni',\n    '/cerez-politikasi',\n    '/kullanim-kosullari',\n    '/veri-sahibi-basvuru-formu'\n  ]);\n\n  const normalizePath = () =>\n    (window.location.pathname.replace(/\\/+$/, '') || '/')\n      .toLowerCase();\n\n  function pageReady(path) {\n    if (document.readyState === 'loading') {\n      return false;\n    }\n\n    /* STÜDYO HİKÂYESİ */\n    if (path === '/studyo-hikayesi') {\n      const page = document.querySelector('n1-studyo-v1');\n\n      return !!(\n        page &&\n        page.querySelector('main.st') &&\n        page.querySelector('footer.n1ft') &&\n        page.querySelector('n1-header .n1h-logo') &&\n        page.querySelector('n1-floating-controls') &&\n        customElements.get('n1-floating-controls')\n      );\n    }\n\n    /* YARATICI BAKIŞIMIZ */\n    if (path === '/yaratici-bakisimiz') {\n      const page = document.querySelector('n1-yaratici-v1');\n      const narrow = window.matchMedia(\n        '(max-width:1024px)'\n      ).matches;\n\n      return !!(\n        page &&\n        page.querySelector('main.n1v#n1v-main') &&\n        page.querySelector('footer.n1ft') &&\n        page.querySelector('n1-header .n1h-logo') &&\n        page.querySelector('n1-floating-controls') &&\n        customElements.get('n1-floating-controls') &&\n        (\n          !narrow ||\n          document.getElementById('n1v-mobile-controls')\n        )\n      );\n    }\n\n    /* DİĞER WIX SAYFALARI */\n    return !!(\n      document.body &&\n      document.querySelector(\n        '#SITE_CONTAINER, main, [role=\"main\"]'\n      )\n    );\n  }\n\n  let active = null;\n  let lastPath = null;\n\n  function createLoader(path) {\n    const loader = document.createElement('div');\n\n    loader.id = 'n1GlobalLoader';\n    loader.setAttribute('role', 'status');\n    loader.setAttribute('aria-label', 'Sayfa yükleniyor');\n\n    loader.innerHTML = `\n      <div class=\"n1-loader-counter\" aria-hidden=\"true\">\n        <span class=\"n1-loader-percent\">%</span>\n        <span class=\"n1-loader-digits\">01</span>\n      </div>\n    `;\n\n    (document.body || document.documentElement)\n      .appendChild(loader);\n\n    const digits = loader.querySelector(\n      '.n1-loader-digits'\n    );\n\n    let progress = 1;\n    let done = false;\n    let forced = false;\n    let fadeTimer = 0;\n    let removeTimer = 0;\n\n    function finish() {\n      if (done) return;\n\n      done = true;\n      clearInterval(timer);\n      clearTimeout(safety);\n\n      digits.textContent = '99';\n\n      fadeTimer = setTimeout(function () {\n        loader.classList.add('n1-loader-close');\n      }, 120);\n\n      removeTimer = setTimeout(function () {\n        loader.remove();\n      }, 700);\n    }\n\n    const timer = setInterval(function () {\n      if (done) return;\n\n      if (\n        progress < 94 ||\n        forced ||\n        pageReady(path)\n      ) {\n        progress = Math.min(progress + 1, 99);\n      }\n\n      digits.textContent = String(progress)\n        .padStart(2, '0');\n\n      if (progress === 99) {\n        finish();\n      }\n    }, 24);\n\n    /* 12 SANİYELİK GÜVENLİK SINIRI */\n    const safety = setTimeout(function () {\n      forced = true;\n    }, 12000);\n\n    return {\n      destroy() {\n        done = true;\n        clearInterval(timer);\n        clearTimeout(safety);\n        clearTimeout(fadeTimer);\n        clearTimeout(removeTimer);\n        loader.remove();\n      }\n    };\n  }\n\n  function checkRoute() {\n    const path = normalizePath();\n\n    if (path === lastPath) return;\n\n    if (active) {\n      active.destroy();\n      active = null;\n    }\n\n    lastPath = path;\n\n    if (ROUTES.has(path)) {\n      active = createLoader(path);\n    }\n  }\n\n  /* İLK AÇILIŞ */\n  checkRoute();\n\n  /* TARAYICI GERİ / İLERİ */\n  window.addEventListener('popstate', checkRoute);\n\n  /* WIX SAYFA GEÇİŞLERİ */\n  setInterval(checkRoute, 500);\n})();\n</script>\n"
 },
